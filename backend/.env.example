# AI Pacab+ 后台系统环境变量配置

# LLM配置
OPENAI_API_KEY=your-openai-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here

# 系统配置
PAPERS_CONFIG_PATH=./config/config.json
PAPERS_LIST_PATH=./config/papers_list.csv
PAPERS_STORAGE_PATH=./papers/
DATA_PATH=./data/

# 小程序配置
MINIPROGRAM_DATA_PATH=../utils/
MINIPROGRAM_UPDATE_URL=https://your-server.com/api/data/update
MINIPROGRAM_DATA_VERSION=20241201_000000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log

# 处理配置
BATCH_SIZE=5
MAX_CONCURRENT=3
DELAY_BETWEEN_REQUESTS=1
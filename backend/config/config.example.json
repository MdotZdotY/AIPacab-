{
  "llm": {
    "provider": "openai",
    "api_key": "your-api-key-here",
    "model": "gpt-4",
    "base_url": "https://api.openai.com/v1",
    "max_tokens": 4000,
    "temperature": 0.7,
    "retry_count": 3,
    "timeout": 30
  },
  "papers": {
    "storage_path": "./papers/",
    "max_file_size": "50MB",
    "supported_formats": ["pdf", "txt"]
  },
  "database": {
    "path": "./data/papers.db",
    "backup_interval": "daily"
  },
  "processing": {
    "batch_size": 5,
    "max_concurrent": 3,
    "delay_between_requests": 1
  },
  "miniprogram": {
    "data_path": "../utils/",
    "update_url": "https://your-server.com/api/data/update"
  }
}
/* pages/import/import.wxss */
.container {
  padding: 20rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #5F6368;
}

/* 导入表单 */
.import-form {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #0D47A1;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 400rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  resize: none;
  line-height: 1.5;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  height: 60rpx;
  border-radius: 30rpx;
  border: none;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.preview {
  background: #0D47A1;
  color: white;
}

.action-btn.stats {
  background: #4caf50;
  color: white;
}

.action-btn.export {
  background: #ff9800;
  color: white;
}

/* 预览区域 */
.preview-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.preview-btn {
  height: 50rpx;
  border-radius: 25rpx;
  border: 2rpx solid #e0e0e0;
  background: white;
  color: #666;
  font-size: 22rpx;
  padding: 0 20rpx;
}

.preview-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.preview-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 20rpx 0;
}

.preview-item:last-child {
  border-bottom: none;
}

.word-info {
  margin-bottom: 15rpx;
}

.word-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.word-meaning {
  display: block;
  font-size: 24rpx;
  color: #1976d2;
  margin-bottom: 5rpx;
}

.word-category {
  display: block;
  font-size: 20rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.word-details {
  font-size: 22rpx;
  color: #666;
}

.word-sentence {
  display: block;
  margin-bottom: 5rpx;
  font-style: italic;
}

.word-paper {
  display: block;
  color: #999;
  font-size: 20rpx;
}

.preview-actions {
  margin-top: 20rpx;
  text-align: center;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  background: #4caf50;
  color: white;
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
}

/* 结果区域 */
.result-section {
  margin-bottom: 30rpx;
}

.result-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.result-stats {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 26rpx;
  color: #666;
}

.result-value {
  font-size: 26rpx;
  font-weight: bold;
}

.result-value.success {
  color: #4caf50;
}

.result-value.warning {
  color: #ff9800;
}

.result-value.total {
  color: #1976d2;
}

/* 底部操作 */
.bottom-actions {
  margin-bottom: 30rpx;
}

.back-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #e0e0e0;
  background: white;
  color: #666;
  font-size: 28rpx;
}
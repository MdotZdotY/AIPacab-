<!--pages/import/import_dpr.wxml-->
<view class="container">
  <view class="header">
    <text class="title">导入DPR论文词汇</text>
    <text class="subtitle">Dense Passage Retrieval for Open-Domain Question Answering</text>
  </view>

  <view class="content">
    <view class="info-card">
      <text class="info-title">论文信息</text>
      <text class="info-text">• 论文标题：Dense Passage Retrieval for Open-Domain Question Answering</text>
      <text class="info-text">• 发表年份：2020年</text>
      <text class="info-text">• 词汇总数：33个</text>
      <text class="info-text">• 包含分类：GRE高频词、TOEFL高频词、IELTS高频词、AI专业词汇</text>
    </view>

    <view class="stats-card">
      <text class="stats-title">词汇统计</text>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-number">8</text>
          <text class="stat-label">GRE高频词</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">8</text>
          <text class="stat-label">TOEFL高频词</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">8</text>
          <text class="stat-label">IELTS高频词</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">9</text>
          <text class="stat-label">AI专业词汇</text>
        </view>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn btn-preview" bindtap="previewDPRVocabulary" disabled="{{isImporting}}">
        预览词汇
      </button>
      <button class="btn btn-import" bindtap="importDPRVocabulary" disabled="{{isImporting}}">
        {{isImporting ? '导入中...' : '导入词汇'}}
      </button>
    </view>

    <view class="result" wx:if="{{importResult}}">
      <text class="result-title">导入结果</text>
      <text class="result-text">成功导入 {{importResult.added}} 个新词汇</text>
      <text class="result-text">跳过 {{importResult.skipped}} 个重复词汇</text>
      <text class="result-text">当前词汇库共有 {{importResult.total}} 个词汇</text>
    </view>
  </view>

  <!-- 预览弹窗 -->
  <view class="preview-modal" wx:if="{{showPreview}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">词汇预览</text>
        <text class="modal-close" bindtap="closePreview">×</text>
      </view>
      <scroll-view class="modal-body" scroll-y="true">
        <view class="word-list">
          <view class="word-item" wx:for="{{previewWords}}" wx:key="id">
            <view class="word-header">
              <text class="word-text">{{item.word}}</text>
              <text class="word-category">{{item.category}}</text>
            </view>
            <text class="word-meaning">{{item.meaning}}</text>
            <text class="word-sentence">{{item.sentence}}</text>
            <text class="word-translation">{{item.translation}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

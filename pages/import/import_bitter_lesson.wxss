/* pages/import/import_bitter_lesson.wxss */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.paper-info {
  margin-bottom: 30rpx;
}

.paper-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.paper-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.paper-authors {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.paper-year {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.paper-abstract {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.import-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.import-status {
  margin-bottom: 30rpx;
}

.status-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.status {
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

.status.ready {
  background-color: #e3f2fd;
  border: 2rpx solid #2196f3;
}

.status.importing {
  background-color: #fff3e0;
  border: 2rpx solid #ff9800;
}

.status.success {
  background-color: #e8f5e8;
  border: 2rpx solid #4caf50;
}

.status.error {
  background-color: #ffebee;
  border: 2rpx solid #f44336;
}

.status-text {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status.ready .status-text {
  color: #1976d2;
}

.status.importing .status-text {
  color: #f57c00;
}

.status.success .status-text {
  color: #388e3c;
}

.status.error .status-text {
  color: #d32f2f;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background-color: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff9800, #ff5722);
  transition: width 0.3s ease;
}

.progress-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
}

.result-info {
  margin-top: 20rpx;
}

.result-item {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
  text-align: left;
}

.error-message {
  display: block;
  font-size: 26rpx;
  color: #d32f2f;
  margin-top: 10rpx;
}

.action-buttons {
  text-align: center;
}

.import-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0.3);
}

.import-btn:disabled {
  background: #ccc;
  box-shadow: none;
}

.reset-btn {
  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(76, 175, 80, 0.3);
}

.vocabulary-preview {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.preview-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.vocab-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.vocab-item {
  background: #f0f8ff;
  border: 2rpx solid #e3f2fd;
  border-radius: 20rpx;
  padding: 15rpx 25rpx;
}

.vocab-word {
  font-size: 26rpx;
  color: #1976d2;
  font-weight: 500;
}

.category-stats {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.stats-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e9ecef;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #007bff;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
}
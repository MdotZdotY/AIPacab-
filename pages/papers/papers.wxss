/* pages/papers/papers.wxss */
.container {
  padding: 0; /* 移除容器padding，手动控制各元素的间距 */
  padding-bottom: 130rpx; /* 为底部导航预留空间 */
  background-color: #F5F7FA;
  min-height: 100vh;
}

/* 搜索区域 - 固定定位 */
.search-section {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #F5F7FA;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-box {
  position: relative;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-left: 10rpx;
  margin-right: 10rpx;
}

.search-input {
  width: 100%;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
  padding-right: 60rpx;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}

/* 论文列表 */
.papers-list {
  margin-bottom: 30rpx;
  padding: 0 20rpx;
  margin-top: 120rpx; /* 为固定搜索框预留空间 */
}

.paper-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.paper-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* 论文标题和作者 */
.paper-header {
  margin-bottom: 20rpx;
}

.paper-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1; /* 与词汇页单词颜色保持一致 */
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.paper-authors {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.3;
}

/* 论文信息 */
.paper-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
}

.info-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

/* 论文摘要 */
.paper-abstract {
  margin-bottom: 20rpx;
}

.abstract-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 查看详情按钮 */
.detail-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  color: #0D47A1;
  font-size: 26rpx;
  font-weight: 500;
}

.arrow {
  font-size: 24rpx;
  color: #0D47A1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
  margin: 120rpx 20rpx 0 20rpx; /* 为固定搜索框预留空间 */
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-subtext {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}
/* pages/paper-detail/paper-detail.wxss */
.container {
  padding: 20rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
}

/* 论文标题 */
.paper-header {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.paper-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.paper-authors {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.3;
}

.paper-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  background: #E3F2FD;
  color: #0D47A1;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 内容区块 */
.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #E3F2FD;
}

.section-content {
  line-height: 1.6;
}

.abstract-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  font-style: italic;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 链接区域 */
.link-section {
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

.link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  background: linear-gradient(135deg, #0D47A1, #1976d2);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  width: 100%;
}

.link-btn:active {
  opacity: 0.8;
}

/* 去掉图标占位 */
.link-icon { display: none; }

.link-text {
  font-weight: 500;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #666;
  font-size: 28rpx;
}
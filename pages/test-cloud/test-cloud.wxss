/* pages/test-cloud/test-cloud.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.button-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-secondary {
  background: #f8f9fa;
  color: #495057;
  border: 2rpx solid #dee2e6;
}

.test-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-test {
  background: white;
  color: #495057;
  border: 2rpx solid #e9ecef;
  font-size: 24rpx;
  padding: 16rpx;
}

.btn-test:active {
  background: #f8f9fa;
}

.results-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.results-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.result-item {
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #f8f9fa;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.test-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.test-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.test-status.success {
  background: #d4edda;
  color: #155724;
}

.test-status.failed {
  background: #f8d7da;
  color: #721c24;
}

.test-time {
  display: block;
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 10rpx;
}

.test-details {
  background: white;
  padding: 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #dee2e6;
}

.details-text {
  font-size: 24rpx;
  color: #495057;
  word-break: break-all;
  line-height: 1.4;
}

.empty-results {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #6c757d;
  font-size: 28rpx;
}

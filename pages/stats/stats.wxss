/* pages/stats/stats.wxss */
/* 只给页面顶部添加最小的调整 */
.container {
  padding: 20rpx; /* 整页统一左右边距 */
  background-color: #F5F7FA;
  min-height: 100vh;
  /* 为底部导航+安全区预留更大空间，让底部按钮离导航更远 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
}

/* 基础样式 - 适用于模拟器 */
.overview-section:first-child {
  margin-top: 0; /* 模拟器中保持正常位置 */
}

/* 针对真机的特殊调整 */
@media screen and (max-width: 393px) {
  .overview-section:first-child {
    margin-top: -40rpx; /* 在真机上向上移动40rpx */
  }
}

/* 概览区域 */
.overview-section {
  margin-bottom: 24rpx; /* 收紧区块下间距 */
}

/* 顶部学习概览向下挪动一点 */
.overview-top {
  margin-top: 20rpx; /* 减少顶部间距，与其他页面保持一致 */
  margin-bottom: 0rpx; /* 紧贴下一区域 */
}

/* 分类统计向下移动，增加与上方的间距 */
.overview-categories {
  margin-top: 24rpx; /* 增加与上方的垂直间距，从-24rpx改为24rpx */
  margin-bottom: 16rpx; /* 降低与分享按钮的间距 */
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 20rpx;
  padding-left: 0; /* 与其它区域标题左边对齐 */
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}

.stat-card:active {
  transform: scale(0.98);
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #5F6368;
}

/* 分类统计模块已移除 */

/* 趋势区域 */
.trend-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.period-selector {
  display: flex;
  gap: 10rpx;
}

.period-item {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e0e0e0;
  background: white;
  transition: all 0.3s ease;
}

.period-item.active {
  background: #1976d2;
  color: white;
  border-color: #1976d2;
}

.period-text {
  font-size: 22rpx;
}

.trend-chart {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx; /* 与上方卡片内边距保持一致 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden; /* 保底裁剪 */
  width: 100%;
  margin-left: 0;
  margin-right: 0;     /* 与概览卡片保持左右对齐 */
  box-sizing: border-box;
}
.chart-title {
  font-size: 26rpx;
  color: #5F6368;
  margin-bottom: 10rpx;
}
.trend-canvas { width: 100%; height: 260rpx; }

.chart-container {
  display: flex;
  align-items: end;
  justify-content: flex-start; /* 按顺序从左到右，不再两端对齐拉伸 */
  height: 220rpx;
  padding-top: 10rpx;
  overflow: hidden; /* 防止内容溢出左右边界 */
}

.chart-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

/* 堆叠柱条 */
.stack-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.chart-item { flex: 0 0 26rpx; margin: 0 6rpx; min-width: 0; } /* 固定柱宽，避免被拉伸 */
.stack {
  width: 100%;
}
.stack.gre { background: #1976d2; }
.stack.toefl { background: #66bb6a; }
.stack.ielts { background: #ffb300; }
.stack.ai { background: #8e24aa; }

.chart-label {
  font-size: 20rpx;
  color: #666;
  white-space: nowrap;
}

.chart-legend {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.legend-item { display: flex; align-items: center; gap: 6rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot.gre { background: #1976d2; }
.dot.toefl { background: #66bb6a; }
.dot.ielts { background: #ffb300; }
.dot.ai { background: #8e24aa; }

.chart-empty {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  color: #999;
  font-size: 24rpx;
}

/* 建议区域 */
.suggestion-section {
  margin-bottom: 30rpx;
}

.suggestion-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  margin-top: 5rpx;
}

.suggestion-content {
  flex: 1;
}

.suggestion-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.suggestion-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 分享区域 */
.share-section {
  margin: 8rpx 0 48rpx 0; /* 增加底部留白，远离底部导航 */
}

.share-buttons {
  display: flex;
  gap: 20rpx;
}

.share-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-friend {
  background: linear-gradient(135deg, #1976d2, #42a5f5);
  color: white;
}

.share-moments {
  background: linear-gradient(135deg, #4caf50, #66bb6a);
  color: white;
}

.share-text {
  font-weight: 500;
}

/* Canvas样式 */
.share-canvas {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  z-index: -1;
}

/* 版本信息 */
.version-info {
  margin-top: 60rpx;
  text-align: center;
  padding-bottom: 20rpx;
}

.version-text {
  font-size: 24rpx;
  color: #999;
}
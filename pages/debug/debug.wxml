<!--pages/debug/debug.wxml-->
<view class="container">
  <view class="header">
    <text class="title">调试页面</text>
    <text class="subtitle">检查和修复数据问题</text>
  </view>

  <!-- 数据状态 -->
  <view class="status-section">
    <text class="section-title">数据状态</text>
    <view class="status-list">
      <view class="status-item">
        <text class="label">全局词汇数量:</text>
        <text class="value">{{debugInfo.globalDataWords}}</text>
      </view>
      <view class="status-item">
        <text class="label">本地存储词汇:</text>
        <text class="value">{{debugInfo.localStorageWords}}</text>
      </view>
      <view class="status-item">
        <text class="label">重置标记:</text>
        <text class="value">{{debugInfo.resetFlag ? '已设置' : '未设置'}}</text>
      </view>
      <view class="status-item">
        <text class="label">启动时间:</text>
        <text class="value">{{debugInfo.appLaunchTime}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="button-section">
    <button class="btn btn-primary" bindtap="restoreDefaultData" loading="{{loading}}">
      恢复默认数据
    </button>
    <button class="btn btn-secondary" bindtap="testCloudFunction" loading="{{loading}}">
      测试云函数
    </button>
    <button class="btn btn-warning" bindtap="clearAllData">
      清空所有数据
    </button>
    <button class="btn btn-success" bindtap="goToHome">
      返回首页
    </button>
  </view>

  <!-- 说明 -->
  <view class="info-section">
    <text class="info-title">说明</text>
    <text class="info-text">• 如果页面显示为空，点击"恢复默认数据"</text>
    <text class="info-text">• 如果云函数有问题，点击"测试云函数"</text>
    <text class="info-text">• 恢复数据后点击"返回首页"查看效果</text>
  </view>
</view>

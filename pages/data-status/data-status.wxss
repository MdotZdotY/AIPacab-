/* pages/data-status/data-status.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #2E86AB, #A23B72);
  border-radius: 20rpx;
  color: white;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 区块样式 */
.section {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.refresh-btn {
  font-size: 28rpx;
  padding: 8rpx 16rpx;
  background-color: #f0f8ff;
  border-radius: 20rpx;
  color: #2E86AB;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background-color: #f8fafe;
  border-radius: 12rpx;
  border: 2rpx solid #e6f3ff;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #2E86AB;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 信息列表 */
.info-list, .storage-list {
  space-y: 12rpx;
}

.info-item, .storage-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child, .storage-item:last-child {
  border-bottom: none;
}

.info-label, .storage-label {
  font-size: 28rpx;
  color: #666;
}

.info-value, .storage-size {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.storage-item.total {
  border-top: 2rpx solid #2E86AB;
  margin-top: 10rpx;
  padding-top: 20rpx;
}

.storage-item.total .storage-label,
.storage-item.total .storage-size {
  color: #2E86AB;
  font-weight: bold;
}

/* 完整性检查 */
.integrity-list {
  space-y: 12rpx;
}

.integrity-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.integrity-item.valid {
  background-color: #f0f9f0;
  border: 2rpx solid #d4edda;
}

.integrity-item.invalid {
  background-color: #fdf2f2;
  border: 2rpx solid #f5c6cb;
}

.integrity-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.integrity-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.integrity-status {
  font-size: 24rpx;
  font-weight: bold;
}

.integrity-item.valid .integrity-status {
  color: #28a745;
}

.integrity-item.invalid .integrity-status {
  color: #dc3545;
}

/* 问题提示 */
.issues-alert {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #fff3cd;
  border: 2rpx solid #ffeaa7;
  border-radius: 12rpx;
}

.alert-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #856404;
  margin-bottom: 12rpx;
}

.issue-item {
  font-size: 26rpx;
  color: #856404;
  margin-bottom: 8rpx;
}

.fix-btn {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background-color: #ffc107;
  color: #856404;
  border-radius: 8rpx;
  text-align: center;
  font-weight: bold;
}

/* 备份管理 */
.backup-info {
  space-y: 20rpx;
}

.backup-status {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.backup-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.backup-text {
  font-size: 28rpx;
  color: #333;
}

.backup-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.backup-btn {
  flex: 1;
  padding: 16rpx;
  background-color: #e3f2fd;
  color: #1976d2;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  text-align: center;
}

.action-btn.primary {
  background-color: #2E86AB;
  color: white;
}

.action-btn.secondary {
  background-color: #f8f9fa;
  color: #6c757d;
  border: 2rpx solid #dee2e6;
}

.btn-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 底部说明 */
.footer-note {
  text-align: center;
  padding: 30rpx;
  margin-top: 20rpx;
}

.note-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .stats-grid {
    grid-template-columns: 1fr;
    gap: 12rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
}



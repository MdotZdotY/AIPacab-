/* pages/simple-test/simple-test.wxss */
.container {
  padding: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.content {
  background: white;
  padding: 40rpx;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.message {
  display: block;
  font-size: 36rpx;
  color: #007bff;
  margin-bottom: 20rpx;
}

.words-count {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  padding: 20rpx;
  background: #007bff;
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* pages/manage/manage.wxss */
.container {
  padding: 20rpx;
  background-color: #F5F7FA;
  height: 100vh;             /* 视口高度 */
  display: flex;
  flex-direction: column;    /* 顶部区域按顺序排列 */
  overflow: hidden;          /* 禁止页面本身滚动 */
}

/* 搜索区域 */
.search-section {
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
}

.search-box {
  position: relative;
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex: 1;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}

/* 分类区域 */
.category-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.category-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 20rpx;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
  border: 2rpx solid #e0e0e0;
  background: white;
  transition: all 0.3s ease;
}

.category-item.active {
  background: #0D47A1;
  color: white;
  border-color: #0D47A1;
}

.category-text {
  font-size: 24rpx;
}

/* 统计区域 */
.stats-section {
  display: flex;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

/* 当统计放在卡片内部时，去掉外扩边距并与上方分类留出间距 */
.stats-section.inside-card {
  margin-left: 0;
  margin-right: 0;
  margin-top: 24rpx;
}

.stats-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.stats-label-inline {
  display: inline;
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.stats-number-inline {
  display: inline;
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1;
}



/* 词汇列表区域 */
.word-list {
  flex: 1;                   /* 占据剩余空间 */
  overflow: hidden;          /* 隐藏溢出内容 */
}

.word-list-inner {
  padding-bottom: 20rpx;     /* 底部留白 */
}

.word-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.word-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.word-info {
  width: 100%;
}

.word-main {
  margin-bottom: 15rpx;
}

.word-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.word-meaning {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.word-meta {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.category-tag {
  background: #e3f2fd;
  color: #1976d2;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.study-info {
  font-size: 24rpx;
  color: #999;
}








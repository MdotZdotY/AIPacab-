/* pages/manage/manage.wxss */
.container {
  padding: 0; /* 移除容器padding，手动控制各元素的间距 */
  background-color: #F5F7FA;
  height: 100vh;             /* 视口高度 */
  display: flex;
  flex-direction: column;    /* 顶部区域按顺序排列 */
  overflow: hidden;          /* 禁止页面本身滚动 */
}

/* 搜索区域 - 使用Flexbox方案 */
.search-section {
  padding: 20rpx;
  margin-bottom: 10rpx;
  display: flex;
  width: 100%;
}

.search-box {
  position: relative;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex: 1; /* 自动占用剩余空间 */
  display: flex;
  width: 100%;
  box-sizing: border-box; /* 确保padding包含在宽度内 */
  margin-left: 15rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1; /* 自动占用剩余空间 */
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
  padding-right: 60rpx;
  box-sizing: border-box; /* 重要：确保padding不会超出容器 */
  border: none;
  outline: none;
}

.search-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}




/* 数据管理入口 */
.data-management-section {
  margin: 20rpx 0;
}

.management-btn {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  margin-bottom: 20rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.btn-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.btn-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 词汇列表区域 */
.word-list {
  flex: 1;                   /* 占据剩余空间 */
  overflow: hidden;          /* 隐藏溢出内容 */
}

.word-list-inner {
  padding: 0 20rpx 20rpx 20rpx;     /* 添加左右padding，与搜索区域保持一致 */
}

.word-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 0 0 20rpx 0;  /* 明确设置左右外边距为0，确保与分类卡片宽度一致 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.word-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.word-info {
  width: 100%;
}

.word-main {
  margin-bottom: 15rpx;
}

.word-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1; /* 与论文页标题颜色保持一致 */
  margin-bottom: 8rpx;
}

.word-meaning {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.word-meta {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.category-tag {
  background: #e3f2fd;
  color: #1976d2;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.study-info {
  font-size: 24rpx;
  color: #999;
}










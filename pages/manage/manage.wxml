<!--pages/manage/manage.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-box">
      <input class="search-input" 
             placeholder="搜索词汇..." 
             value="{{searchKeyword}}"
             bindinput="onSearch" />
      <text class="search-icon">🔍</text>
    </view>


  </view>

  <!-- 分类筛选 + 统计信息（同一卡片） -->
  <view class="category-section">
    <view class="category-title"></view>
    <view class="category-list">
      <view class="category-item {{activeCategory === filter.value ? 'active' : ''}}"
            wx:for="{{categoryFilters}}" 
            wx:for-item="filter"
            wx:key="value"
            bindtap="selectCategory"
            data-category="{{filter.value}}">
        <text class="category-text">{{filter.display}}</text>
      </view>
    </view>

    <!-- 统计信息并入同一卡片 -->
    <view class="stats-section inside-card">
      <view class="stats-item">
        <text class="stats-label-inline">总词汇量</text>
        <text class="stats-number-inline">{{totalCount}}</text>
      </view>
      <view class="stats-item">
        <text class="stats-label-inline">筛选结果</text>
        <text class="stats-number-inline">{{filteredWords.length}}</text>
      </view>
    </view>
  </view>

  



  

  

  <!-- 词汇列表（仅列表区域可滚动） -->
  <scroll-view class="word-list" scroll-y="true" enable-flex="true" show-scrollbar="true">
    <view class="word-list-inner">
    <view class="word-item" 
          wx:for="{{filteredWords}}" 
          wx:key="id"
          bindtap="viewWordDetail" 
          data-id="{{item.id}}">
      <view class="word-info">
        <view class="word-main">
          <text class="word-text">{{item.word}}</text>
          <text class="word-meaning">{{item.meaning}}</text>
        </view>
        <view class="word-meta">
          <text class="category-tag">{{item.category}}</text>
          <text class="study-info">学习{{item.studyCount}}次</text>
        </view>
      </view>
    </view>
    </view>
  </scroll-view>




</view>
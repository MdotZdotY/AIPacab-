<!--pages/manage/manage.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-box">
      <input class="search-input" 
             placeholder="搜索词汇..." 
             value="{{searchKeyword}}"
             bindinput="onSearch" />
      <text class="search-icon">🔍</text>
    </view>

    <!-- 添加词汇按钮 -->
    <view class="add-fab" bindtap="showAddWord" hover-class="fab-active">
      <text class="fab-plus">+</text>
    </view>
  </view>

  <!-- 分类筛选 + 统计信息（同一卡片） -->
  <view class="category-section">
    <view class="category-title"></view>
    <view class="category-list">
      <view class="category-item {{activeCategory === filter.value ? 'active' : ''}}"
            wx:for="{{categoryFilters}}" 
            wx:for-item="filter"
            wx:key="value"
            bindtap="selectCategory"
            data-category="{{filter.value}}">
        <text class="category-text">{{filter.display}}</text>
      </view>
    </view>

    <!-- 统计信息并入同一卡片 -->
    <view class="stats-section inside-card">
      <view class="stats-item">
        <text class="stats-label-inline">总词汇量</text>
        <text class="stats-number-inline">{{totalCount}}</text>
      </view>
      <view class="stats-item">
        <text class="stats-label-inline">筛选结果</text>
        <text class="stats-number-inline">{{filteredWords.length}}</text>
      </view>
    </view>
  </view>

  



  

  

  <!-- 词汇列表（仅列表区域可滚动） -->
  <scroll-view class="word-list" scroll-y="true" enable-flex="true" show-scrollbar="true">
    <view class="word-list-inner">
    <view class="word-item" 
          wx:for="{{filteredWords}}" 
          wx:key="id"
          bindtap="viewWordDetail" 
          data-id="{{item.id}}">
      <view class="word-info">
        <view class="word-main">
          <text class="word-text">{{item.word}}</text>
          <text class="word-meaning">{{item.meaning}}</text>
        </view>
        <view class="word-meta">
          <text class="category-tag">{{item.category}}</text>
          <text class="study-info">学习{{item.studyCount}}次</text>
        </view>
      </view>
    </view>
    </view>
  </scroll-view>

  <!-- 添加词汇模态框 -->
  <view class="modal-overlay" wx:if="{{showAddModal}}" bindtap="hideAddWord">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">添加新词汇</text>
        <text class="modal-close" bindtap="hideAddWord">×</text>
      </view>
      
      <view class="form-section">
        <view class="form-item">
          <text class="form-label">词汇 *</text>
          <input class="form-input" 
                 placeholder="输入英文词汇"
                 value="{{newWord.word}}"
                 bindinput="onInputChange"
                 data-field="word" />
        </view>
        
        <view class="form-item">
          <text class="form-label">含义 *</text>
          <input class="form-input" 
                 placeholder="输入中文含义"
                 value="{{newWord.meaning}}"
                 bindinput="onInputChange"
                 data-field="meaning" />
        </view>
        
        <view class="form-item">
          <text class="form-label">音标</text>
          <input class="form-input" 
                 placeholder="输入音标"
                 value="{{newWord.pronunciation}}"
                 bindinput="onInputChange"
                 data-field="pronunciation" />
        </view>
        
        <view class="form-item">
          <text class="form-label">例句</text>
          <textarea class="form-textarea" 
                    placeholder="输入例句"
                    value="{{newWord.sentence}}"
                    bindinput="onInputChange"
                    data-field="sentence" />
        </view>
        
        <view class="form-item">
          <text class="form-label">翻译</text>
          <textarea class="form-textarea" 
                    placeholder="输入例句翻译"
                    value="{{newWord.translation}}"
                    bindinput="onInputChange"
                    data-field="translation" />
        </view>
        
        <view class="form-item">
          <text class="form-label">分类</text>
          <picker class="form-picker" 
                  range="{{categories}}" 
                  value="{{categories.indexOf(newWord.category)}}"
                  bindchange="onCategoryChange">
            <view class="picker-text">{{newWord.category}}</view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">论文来源</text>
          <input class="form-input" 
                 placeholder="输入论文标题"
                 value="{{newWord.paperTitle}}"
                 bindinput="onInputChange"
                 data-field="paperTitle" />
        </view>
      </view>
      
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="hideAddWord">取消</button>
        <button class="modal-btn confirm" bindtap="addWord">添加</button>
      </view>
    </view>
  </view>


</view>
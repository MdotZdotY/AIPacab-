<!--pages/manage/manage.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-box">
      <input class="search-input" 
             placeholder="搜索词汇..." 
             value="{{searchKeyword}}"
             bindinput="onSearch" />
      <text class="search-icon">🔍</text>
    </view>


  </view>






  

  

  <!-- 词汇列表（仅列表区域可滚动） -->
  <scroll-view class="word-list" scroll-y="true" enable-flex="true" show-scrollbar="true">
    <view class="word-list-inner">
    <view class="word-item" 
          wx:for="{{filteredWords}}" 
          wx:key="id"
          bindtap="viewWordDetail" 
          data-id="{{item.id}}">
      <view class="word-info">
        <view class="word-main">
          <text class="word-text">{{item.word}}</text>
          <text class="word-meaning">{{item.meaning}}</text>
        </view>
        <view class="word-meta">
          <text class="category-tag">{{item.category}}</text>
          <text class="study-info">学习{{item.studyCount}}次</text>
        </view>
      </view>
    </view>
    </view>
  </scroll-view>

</view>
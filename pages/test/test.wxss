/* pages/test/test.wxss */
.container {
  padding: 15rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 添加统一的间距 */
}

/* 进度区域 */
.progress-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.progress-info {
  margin-bottom: 20rpx;
}

.progress-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background-color: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0D47A1, #1976d2);
  transition: width 0.3s ease;
}

.score-info {
  text-align: center;
}

.score-text {
  font-size: 28rpx;
  color: #0D47A1;
  font-weight: 500;
}

/* 题目卡片 */
.question-card {
  background: white;
  border-radius: 16rpx;
  padding: 60rpx 40rpx; /* 与学习页面保持一致的内边距 */
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  margin-top: 20rpx;
  height: 1000rpx; /* 与学习页面保持一致的固定高度 */
  display: flex;
  flex-direction: column;
  box-sizing: border-box; /* 确保padding包含在宽度内 */
  width: 100%; /* 确保卡片占满容器宽度 */
}

.question-header {
  text-align: center;
  margin-bottom: 30rpx;
  flex-shrink: 0; /* 防止头部被压缩 */
}

.question-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1;
}

.word-section {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  flex-shrink: 0; /* 防止词汇区域被压缩 */
}

.word-text {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 10rpx;
  word-wrap: break-word; /* 允许长单词换行 */
  overflow-wrap: break-word; /* 现代浏览器的换行属性 */
  max-width: 100%; /* 限制最大宽度 */
}

.pronunciation {
  display: block;
  font-size: 24rpx;
  color: #666;
  font-style: italic;
}

.sentence-section {
  margin-bottom: 30rpx;
  flex-shrink: 0; /* 防止例句区域被压缩 */
}

.sentence-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  font-style: italic;
}

/* 选项区域 */
.options-section {
  margin-bottom: 20rpx;
  flex: 1; /* 让选项区域占据剩余空间 */
  display: flex;
  flex-direction: column;
  justify-content: space-around; /* 均匀分布选项 */
}

.option-item {
  position: relative;
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  transition: all 0.3s ease;
  flex-shrink: 0; /* 防止选项被压缩 */
  min-height: 80rpx; /* 确保选项有最小高度 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-item:active {
  background: #e3f2fd;
  border-color: #1976d2;
}

.option-item.correct {
  background: #e8f5e8;
  border-color: #4caf50;
}

.option-item.incorrect {
  background: #ffebee;
  border-color: #f44336;
}

.option-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  word-wrap: break-word; /* 允许长文本换行 */
  overflow-wrap: break-word; /* 现代浏览器的换行属性 */
  max-width: 100%; /* 限制最大宽度 */
}

.option-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  font-weight: bold;
}

.option-icon.correct-icon {
  color: #4caf50;
}

.option-item.correct .option-icon {
  color: #4caf50;
}

.option-item.incorrect .option-icon {
  color: #f44336;
}

/* 提示区域 */
.tip-section {
  text-align: center;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作 */
.bottom-actions {
  margin-bottom: 20rpx;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #e0e0e0;
  background: white;
  color: #666;
  font-size: 28rpx;
}
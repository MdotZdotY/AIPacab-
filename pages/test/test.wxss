/* pages/test/test.wxss */
.container {
  padding: 20rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
}

/* 进度区域 */
.progress-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.progress-info {
  margin-bottom: 20rpx;
}

.progress-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background-color: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0D47A1, #1976d2);
  transition: width 0.3s ease;
}

.score-info {
  text-align: center;
}

.score-text {
  font-size: 28rpx;
  color: #0D47A1;
  font-weight: 500;
}

/* 题目卡片 */
.question-card {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.question-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.question-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1;
}

.word-section {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.word-text {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #0D47A1;
  margin-bottom: 10rpx;
}

.pronunciation {
  display: block;
  font-size: 24rpx;
  color: #666;
  font-style: italic;
}

.sentence-section {
  margin-bottom: 30rpx;
}

.sentence-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  font-style: italic;
}

/* 选项区域 */
.options-section {
  margin-bottom: 20rpx;
}

.option-item {
  position: relative;
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.option-item:active {
  background: #e3f2fd;
  border-color: #1976d2;
}

.option-item.correct {
  background: #e8f5e8;
  border-color: #4caf50;
}

.option-item.incorrect {
  background: #ffebee;
  border-color: #f44336;
}

.option-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.option-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  font-weight: bold;
}

.option-icon.correct-icon {
  color: #4caf50;
}

.option-item.correct .option-icon {
  color: #4caf50;
}

.option-item.incorrect .option-icon {
  color: #f44336;
}

/* 提示区域 */
.tip-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作 */
.bottom-actions {
  margin-bottom: 30rpx;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #e0e0e0;
  background: white;
  color: #666;
  font-size: 28rpx;
}
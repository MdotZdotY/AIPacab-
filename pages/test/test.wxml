<!--pages/test/test.wxml-->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-section">
    <view class="progress-info">
      <text class="progress-text">第 {{currentIndex + 1}} 题 / 共 {{totalWords}} 题</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%"></view>
      </view>
    </view>
    <view class="score-info">
      <text class="score-text">得分：{{score}}/{{totalScore}}</text>
    </view>
  </view>

  <!-- 题目卡片 -->
  <view class="question-card" wx:if="{{currentWord}}">
    <view class="question-header">
      <text class="question-title">选择正确的中文含义</text>
    </view>
    
    <view class="word-section">
      <text class="word-text">{{currentWord.word}}</text>
      <text class="pronunciation">{{currentWord.pronunciation}}</text>
    </view>

    <view class="sentence-section">
      <text class="sentence-text">{{currentWord.sentence}}</text>
    </view>

    <!-- 选项 -->
    <view class="options-section">
      <view class="option-item {{selectedAnswer === item ? (isCorrect ? 'correct' : 'incorrect') : ''}} {{isAnswered && item === currentWord.meaning ? 'correct' : ''}}"
            wx:for="{{options}}" 
            wx:key="*this"
            bindtap="selectAnswer"
            data-answer="{{item}}">
        <text class="option-text">{{item}}</text>
        <text class="option-icon" wx:if="{{isAnswered && selectedAnswer === item}}">
          {{isCorrect ? '✓' : '✗'}}
        </text>
        <text class="option-icon correct-icon" wx:if="{{isAnswered && item === currentWord.meaning && selectedAnswer !== currentWord.meaning}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tip-section">
    <text class="tip-text">点击选项选择答案，测试完成后会显示详细结果</text>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions">
    <button class="action-btn" bindtap="goToHome">
      返回首页
    </button>
  </view>
</view>
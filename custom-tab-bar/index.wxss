.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 调整高度为92rpx，避免遮挡并保持居中 */
  height: calc(92rpx + constant(safe-area-inset-bottom));
  height: calc(92rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  align-items: center; /* 使各项在容器内垂直居中 */
  border-top: 1rpx solid #eee;
  box-sizing: border-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.tab-text {
  font-size: 28rpx; /* 调整为28rpx */
  font-weight: 400; /* 取消加粗 */
  color: #5F6368;
}
.tab-text.active {
  color: #0D47A1;
}

